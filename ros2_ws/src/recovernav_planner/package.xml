<?xml version="1.0"?>
<package format="3">
  <name>recovernav_planner</name>
  <version>0.2.0</version>
  <description>Recoverability-aware Nav2 global planner plugin.</description>
  <maintainer email="75089541+panagiotagrosdouli@users.noreply.github.com">panagiotagrosdouli</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/recovernav_planner_plugin.xml"/>
  </export>
</package>
